{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sections"
  ],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "kind",
          "sceneSequence",
          "content"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 19
          },
          "kind": {
            "type": "string",
            "enum": [
              "SCENE",
              "AI_BRIDGE"
            ]
          },
          "sceneSequence": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "SCENE"
                }
              }
            },
            "then": {
              "properties": {
                "sceneSequence": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              }
            },
            "else": {
              "properties": {
                "sceneSequence": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  }
}
