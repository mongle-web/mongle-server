{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "elements",
    "scenes"
  ],
  "properties": {
    "elements": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "type",
          "name",
          "description"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,39}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "CHARACTER",
              "PLACE",
              "SYMBOL",
              "EMOTION"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "content",
          "disconnectedFromPrevious",
          "elementKeys"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "disconnectedFromPrevious": {
            "type": "boolean"
          },
          "elementKeys": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        }
      }
    }
  }
}
