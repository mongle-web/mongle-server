# EC2 ONLY. /etc/mongle-migration/migration.env, root:root 0600.
# Do not commit a populated copy or reuse the application's DB account.
MONGLE_MIGRATION_DB_URL=jdbc:mysql://mongle-prod-db.c7caskqkw2ty.ap-northeast-2.rds.amazonaws.com:3306/mongle
MONGLE_MIGRATION_EXPECTED_HOST=mongle-prod-db.c7caskqkw2ty.ap-northeast-2.rds.amazonaws.com
MONGLE_MIGRATION_EXPECTED_DATABASE=mongle
MONGLE_MIGRATION_DB_USERNAME=mongle_migrator
MONGLE_MIGRATION_DB_PASSWORD=<SET_ONLY_ON_EC2>
MONGLE_MIGRATION_TRUSTSTORE_URL=file:/etc/mongle-migration/rds-truststore.p12
MONGLE_MIGRATION_TRUSTSTORE_PASSWORD=<SET_ONLY_ON_EC2>
